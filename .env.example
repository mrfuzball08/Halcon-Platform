# ============================================================
# Halcon Platform Docker Compose Environment
# Copy this file to .env at repository root and fill in real values.
# ============================================================

# ---------- Published ports on your host ----------
FRONTEND_PORT=3000
API_PORT=8080

# ---------- Frontend (Next.js) ----------
# Public URL consumed by browser-side code. Should point to host-accessible API.
# Passed through docker-compose as frontend environment values.
NEXT_PUBLIC_API_URL=http://localhost:8080/api
# Set to true only when you want to bypass backend auth with frontend mock users.
NEXT_PUBLIC_MOCK_AUTH=false

# ---------- Backend (ASP.NET Core API) ----------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_SCHEMA=public
SUPABASE_STORAGE_BUCKET=order-evidence

# CORS
CORS_ALLOWED_ORIGIN=http://localhost:3000

# Initial admin seed behavior
SEED_ADMIN_ON_STARTUP=false
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@halcon.local
SEED_ADMIN_PASSWORD=Admin123!
SEED_ADMIN_ROLE=ADMIN
SEED_ADMIN_TOKEN=replace-with-a-strong-one-time-token
