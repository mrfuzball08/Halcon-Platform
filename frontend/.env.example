# ============================================================
# Halcon Platform — Environment Variables
# ============================================================
# Copy this file to .env.local and configure for your environment.
#
# SWITCHING FROM MOCK TO REAL .NET API:
# 1. Set NEXT_PUBLIC_API_URL to your .NET API URL
# 2. Set NEXT_PUBLIC_MOCK_AUTH=false
# 3. Restart the dev server
# ============================================================

# Base URL for the backend .NET API
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Enable mock authentication for development (bypasses real API)
# Set to "false" or remove entirely when the .NET backend is ready
NEXT_PUBLIC_MOCK_AUTH=true
